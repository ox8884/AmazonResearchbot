[Unit]
Description=Forge Kitchen Ops daily planner tick
After=postgresql.service

[Service]
Type=oneshot
User=forge-ops-scheduler
Group=forge-ops-scheduler
WorkingDirectory=/opt/forge-ops/current
EnvironmentFile=/etc/forge-ops/runtime.env
Environment=APP_ENV=production
Environment=DATABASE_URL=postgresql:///forge_ops?host=/var/run/postgresql&user=forge_ops_scheduler
Environment=JS_TRANSPORT=disabled
ExecStart=/usr/bin/node --import tsx apps/worker/src/scheduler.ts --production
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
